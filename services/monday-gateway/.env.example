# ── monday-gateway env (set these in Railway → Variables) ──────────────────

# Monday.com API token (server-side). This REPLACES the token currently baked
# into the browser bundle. Same value you have in VITE_MONDAY_API_TOKEN today.
MONDAY_API_TOKEN=

# Postgres connection string. Railway injects this automatically when you add a
# Postgres database to the project and reference it (e.g. ${{Postgres.DATABASE_URL}}).
DATABASE_URL=

# CORS allowlist (comma-separated). Defaults to the live site + localhost dev.
ALLOWED_ORIGINS=https://medically-modern.github.io,http://localhost:5173,http://localhost:8080

# Monday API version forwarded upstream (the SPA also sends its own per-module).
MONDAY_API_VERSION=2024-10

# What to persist:  off | mutations | all   (default all)
LOG_MODE=all

# Store the full GraphQL query text + variables?
# ⚠ Variables contain PATIENT DATA (PHI): names, DOB, insurance, clinicals.
# Leave false to log metadata only (who / which item / when / outcome).
# Set true ONLY on a secured DB you're comfortable storing PHI in.
LOG_PAYLOAD=false

# Optional shared key. If set, the browser must send a matching X-MM-Key header.
# Note: a key shipped in the bundle is obscurity, not real auth — see README.
GATEWAY_CLIENT_KEY=

# ── RingCentral (fax + SMS proxy) — set these in Railway → Variables ──────────
# Moves the RingCentral OAuth app creds + JWT OFF the browser bundle onto this
# server. Use the new app (MM Portal 2 or Command Center RC) + the Fullaccess2 JWT.
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
# RC_SERVER=https://platform.ringcentral.com   # optional override

# ── Assigned Patients (patient-phone → rep routing) ──────────────────────────
# A SEPARATE Railway Postgres from the audit DB above, so that instance keeps
# its "metadata only, no PHI" property (LOG_PAYLOAD=false).
ASSIGNMENTS_DATABASE_URL=

# Secret for HMAC-SHA256 of patient phone numbers. The assignments table stores
# the HMAC instead of the number, so it holds nothing patient-identifying.
# ⚠ NOT optional and NOT cosmetic: a bare SHA-256 of a 10-digit number is
# brute-forceable in seconds (~10^10 candidates), so without a secret pepper the
# hashing gives no protection at all. The routes 503 while this is unset rather
# than falling back to an unpeppered digest.
# ⚠ Changing this value orphans every existing assignment (all hashes change).
# Generate once with:  openssl rand -hex 32
PHONE_HMAC_PEPPER=

# Who may assign patients to reps and read everyone's assignments.
# Comma-separated, must MIRROR the managers[] list in public/data/access.json.
# The gateway can't read access.json itself (no GitHub token, and one gateway
# serves both the test and prod SPAs, which have separate data repos).
# ⚠ This mirror can drift, and it fails SAFE: a manager added in /access but not
# here gets a clear 403 when assigning, never silent extra access. If assigning
# starts 403ing for someone, check here first.
# Leaving it UNSET means any verified @medicallymodern.com user can reassign
# patients — the server logs a warning at boot. Set it.
MANAGER_EMAILS=
