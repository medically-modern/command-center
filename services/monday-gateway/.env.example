# ── monday-gateway env (set these in Railway → Variables) ──────────────────

# Monday.com API token (server-side). This REPLACES the token currently baked
# into the browser bundle. Same value you have in VITE_MONDAY_API_TOKEN today.
MONDAY_API_TOKEN=

# Postgres connection string. Railway injects this automatically when you add a
# Postgres database to the project and reference it (e.g. ${{Postgres.DATABASE_URL}}).
DATABASE_URL=

# CORS allowlist (comma-separated). Defaults to the live site + localhost dev.
ALLOWED_ORIGINS=https://medically-modern.github.io,http://localhost:5173,http://localhost:8080

# Monday API version forwarded upstream (the SPA also sends its own per-module).
MONDAY_API_VERSION=2024-10

# What to persist:  off | mutations | all   (default all)
LOG_MODE=all

# Store the full GraphQL query text + variables?
# ⚠ Variables contain PATIENT DATA (PHI): names, DOB, insurance, clinicals.
# Leave false to log metadata only (who / which item / when / outcome).
# Set true ONLY on a secured DB you're comfortable storing PHI in.
LOG_PAYLOAD=false

# Optional shared key. If set, the browser must send a matching X-MM-Key header.
# Note: a key shipped in the bundle is obscurity, not real auth — see README.
GATEWAY_CLIENT_KEY=

# ── RingCentral (fax + SMS proxy) — set these in Railway → Variables ──────────
# Moves the RingCentral OAuth app creds + JWT OFF the browser bundle onto this
# server. Use the new app (MM Portal 2 or Command Center RC) + the Fullaccess2 JWT.
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
# RC_SERVER=https://platform.ringcentral.com   # optional override
