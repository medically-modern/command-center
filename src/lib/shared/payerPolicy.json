  "consumers": {
    "$comment": [
      "Every estimator that encodes payer policy. check-payer-policy.mjs reads each",
      "one and compares it to the canonical sets above. `constants` maps this file's",
      "concepts onto whatever the consumer happens to call them. `deviations` lists",
      "differences that are DELIBERATE \u2014 anything not listed here is reported as drift.",
      "Adding a consumer here is what makes it covered; a file nobody lists is a file",
      "nobody checks, which is how the 2026-09 United Medicare / NYSHIP split happened."
    ],
    "command-center-test/welcomeCall": {
      "repo": "medically-modern/command-center-test",
      "path": "src/lib/welcomeCall/oopEstimator.ts",
      "local": true,
      "note": "Canonical implementation. command-center is a force-push mirror of this repo (.github/workflows/sync-from-test.yml), so it is not listed separately.",
      "constants": {
        "zeroOopPayers": "ZERO_OOP_PAYERS",
        "coinsuranceOverrides": "COINSURANCE_OVERRIDES",
        "primaryMedicaidLabels": "PRIMARY_MEDICAID_LABELS",
        "medicareStyleInfusionPayers": "MEDICARE_STYLE_INFUSION_PAYERS",
        "aetnaStylePayers": "AETNA_STYLE_PAYERS",
        "suppliesRouteToMedicaid": "SUPPLIES_ROUTE_TO_MEDICAID"
      },
      "deviations": []
    },
    "command-center-test/profile": {
      "repo": "medically-modern/command-center-test",
      "path": "src/lib/profile/oopEstimate.ts",
      "local": true,
      "note": "Profile Send-Off first-order + recurring estimate. Imports PAYER_RATE_SCHEDULE from welcomeCall, so it carries no rate table of its own. Its United Medicare rule was a 0% coinsurance override until 2026-09-17, which left the deductible payable and made this surface disagree with the reorder form for any member carrying one; it is a zero-OOP payer on both now.",
      "constants": {
        "zeroOopPayers": "ZERO_PAYERS",
        "coinsuranceOverrides": "COINS_OVERRIDES",
        "primaryMedicaidLabels": "PRIMARY_MEDICAID",
        "medicareStyleInfusionPayers": "MEDICARE_STYLE",
        "aetnaStylePayers": null,
        "suppliesRouteToMedicaid": "SUPPLIES_TO_MEDICAID"
      },
      "deviations": [
        {
          "field": "productScope",
          "value": "excludes CGM Monitor (E2103)",
          "reason": "Deliberate, per the Profile redesign handoff: welcome-call includes the monitor, profile does not."
        }
      ]
    },
    "reorder-patient-form/backend": {
      "repo": "medically-modern/reorder-patient-form",
      "path": "backend/src/oopEstimator.js",
      "branch": "main",
      "note": "Cron/link-creation service. Writes the estimate to the Subscription board OOP Estimate column at link-creation time.",
      "constants": {
        "zeroOopPayers": "ZERO_OOP_PAYERS",
        "coinsuranceOverrides": "COINSURANCE_OVERRIDES",
        "primaryMedicaidLabels": "PRIMARY_MEDICAID_LABELS",
        "medicareStyleInfusionPayers": "MEDICARE_STYLE_INFUSION_PAYERS",
        "aetnaStylePayers": "AETNA_STYLE_PAYERS",
        "suppliesRouteToMedicaid": "SUPPLIES_ROUTE_TO_MEDICAID"
      },
      "deviations": [
        {
          "field": "productScope",
          "value": "excludes CGM Monitor (E2103) and Pump (E0784)",
          "reason": "Deliberate: a reorder is consumables only, the patient already has the hardware."
        },
        {
          "field": "secondaryCoverage",
          "value": "only a secondary containing 'medicaid' zeroes the estimate",
          "reason": "UNRESOLVED. command-center treats ANY secondary other than 'None' as covering the balance; the reorder form only matches Medicaid. A 'Medicare Supplement' or 'Other' secondary is quoted a charge here and $0 there."
        }
      ]
    },
    "reorder-patient-form/docs": {
      "repo": "medically-modern/reorder-patient-form",
      "path": "docs/oopEstimator.js",
      "branch": "main",
      "note": "Patient-facing GitHub Pages form at reorder.medicallymodern.com. Byte-identical to the backend copy apart from its module.exports line; computes live in the browser via a plain <script src> tag, so it cannot import a shared module without adding a build step.",
      "constants": {
        "zeroOopPayers": "ZERO_OOP_PAYERS",
        "coinsuranceOverrides": "COINSURANCE_OVERRIDES",
        "primaryMedicaidLabels": "PRIMARY_MEDICAID_LABELS",
        "medicareStyleInfusionPayers": "MEDICARE_STYLE_INFUSION_PAYERS",
        "aetnaStylePayers": "AETNA_STYLE_PAYERS",
        "suppliesRouteToMedicaid": "SUPPLIES_ROUTE_TO_MEDICAID"
      },
      "mirrorOf": "reorder-patient-form/backend",
      "deviations": []
    },
    "coins-form-payment": {
      "repo": "medically-modern/coins-form-payment",
      "path": "src/lib/oopEstimator.ts",
      "branch": "main",
      "note": "Coinsurance payment form. Oldest copy in the org.",
      "constants": {
        "zeroOopPayers": "ZERO_OOP_PAYERS",
        "coinsuranceOverrides": "COINSURANCE_OVERRIDES",
        "primaryMedicaidLabels": "PRIMARY_MEDICAID_LABELS",
        "medicareStyleInfusionPayers": "MEDICARE_STYLE_INFUSION_PAYERS",
        "aetnaStylePayers": "AETNA_STYLE_PAYERS",
        "suppliesRouteToMedicaid": "SUPPLIES_ROUTE_TO_MEDICAID"
      },
      "deviations": []
    }
