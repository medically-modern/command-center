  "zeroOopPayers": {
    "$comment": "Payers that leave no member cost share on the items we resupply. These short-circuit to $0 BEFORE deductible and coinsurance, and stay $0 even when Stedi returns no benefits data.",
    "payers": {
      "Medicare A&B": "MM bills Medicare directly.",
      "NYSHIP": "Empire Plan covers DME in full, no member cost share.",
      "Aetna Medicare": "Fully covered, no cost share (MM-1071, 2026-08-10).",
      "United Medicare": "Fully covered, no cost share \u2014 $0 regardless of deductible or benefits data (Josh, 2026-09-17, resolving the reorder-form / profile split)."
    }
  },
  "coinsuranceOverrides": {
    "$comment": "Whole-number percentages that replace the Stedi coinsurance. NOTE: an entry here still passes the remaining DEDUCTIBLE through to the patient, and only applies when Stedi benefits data is present. For a payer with no cost share at all use zeroOopPayers instead.",
    "overrides": {}
  },
