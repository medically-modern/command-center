# Loaded automatically by `vite build` (production mode).
# Routes all Monday GraphQL through the Railway gateway. The URL is public
# (it ships in the client either way), so it lives here, not in secrets.
# Roll back the cutover by deleting this file (or blanking the value) + rebuild.
VITE_MONDAY_GATEWAY_URL=https://monday-gateway-production.up.railway.app
