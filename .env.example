# Monday.com API token (read/write to board 18410601299)
# Get yours from: monday.com > Admin > API
# For production: set as GitHub secret VITE_MONDAY_API_TOKEN
VITE_MONDAY_API_TOKEN=

# Optional — route all Monday GraphQL through the monday-gateway Railway service
# (services/monday-gateway). When set, the token above is ignored for GraphQL
# (the gateway injects it server-side) and every request is logged to Postgres.
# Leave BLANK to call api.monday.com directly, exactly as before. No-trailing-slash.
# e.g. https://monday-gateway-production.up.railway.app
VITE_MONDAY_GATEWAY_URL=

# GitHub PAT for persisting role assignments across devices
# Needs Contents read/write permission on this repo
VITE_GITHUB_PAT=
